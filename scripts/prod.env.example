# Copy to scripts/prod.env (gitignored) to override the defaults in clone-prod-db.sh.
# Every value here is already the default, so an empty file behaves the same.

PROD_HOST=nopestradamus.com
PROD_USER=root
PROD_SSH_PORT=22

# Private key that logs into the prod host. Default is ./id_rsa in the repo root.
#PROD_SSH_KEY=/home/you/.ssh/id_rsa_nopestradamus

# Pin the remote postgres container instead of auto-detecting it by image name.
#PROD_DB_CONTAINER=nopestradamus-db-1

#DB_NAME=nopestradamus
#DB_USER=postgres
#KEEP_DUMPS=5
