{
  "name": "nopestradamus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-config": "node --input-type=module -e \"import('./util/config.ts').then((m) => m.getConfig())\"",
    "clone-prod-db": "scripts/clone-prod-db.sh",
    "cron": "node server-cron.ts",
    "dev": "next dev",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d --wait && pnpm migrate",
    "dev-session": "node scripts/dev-session.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "health-mail": "node scripts/send-health-mail.ts",
    "knip": "pnpm knip:production && pnpm knip:default",
    "knip:default": "knip --no-progress --no-config-hints",
    "knip:production": "knip --production --no-progress",
    "lint": "oxlint",
    "migrate": "node scripts/migrate.ts",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm validate && pnpm format:check",
    "prepare": "husky || true",
    "release": "docker compose build --pull && docker compose up -d",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "cron": "4.4.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "husky": "9.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.15.0"
}
