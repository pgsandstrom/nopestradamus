{
  "name": "nopestradamus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "scripts": {
    "build": "next build",
    "clone-prod-db": "scripts/clone-prod-db.sh",
    "cron": "node server-cron.ts",
    "dev": "next dev",
    "dev-session": "node scripts/dev-session.ts",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build --no-cache",
    "docker-up": "docker compose up",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check .",
    "knip": "pnpm knip:production && pnpm knip:default",
    "knip:default": "knip --no-progress --no-config-hints",
    "knip:production": "knip --production --no-progress",
    "lint": "eslint --max-warnings 0",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm validate && pnpm format:check",
    "prepare": "husky || true",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test-watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "cron": "4.4.0",
    "next": "16.3.4",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "husky": "9.1.7"
  },
  "lint-staged": {
    "*.{js,mjs,json,md,css,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  }
}
