{
  "name": "nopestradamus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "cron": "node server-cron.ts",
    "dev": "next dev",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build --no-cache",
    "docker-up": "docker compose up",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings 0",
    "pre-commit": "lint-staged",
    "pre-push": "npm run lint && npm run typecheck && npm run test",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test-watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cron": "4.4.0",
    "next": "16.3.4",
    "nodemailer": "10.0.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "husky": "9.1.7"
  },
  "lint-staged": {
    "*.{js,mjs,json,md,css,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ]
  }
}
