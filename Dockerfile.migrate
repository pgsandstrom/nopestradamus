FROM node:24-slim AS base
# The slim image has no CA bundle. Node carries its own, but pnpm 12 is a native binary that
# reads the system store, and it fetches its own registry metadata whenever node_modules exists.
RUN apt-get update \
 && apt-get install --assume-yes --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# ---- dependencies -----------------------------------------------------------
# Same three lines as the other two images on purpose, so this shares their cached layer
# instead of resolving the lockfile a third time.
FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --no-optional

# ---- runtime ----------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
# db/ holds both the .sql files and the runner that reads them; .dockerignore drops the test.
COPY db ./db
COPY util ./util
COPY scripts/migrate.ts ./scripts/migrate.ts

# No config.json or privkey.pem here: this image talks to the database and nothing else, and
# without the key it cannot sign a mail even if something later tried to send one.

# node runs the TypeScript directly via type stripping, so there is no build step
CMD ["node", "scripts/migrate.ts"]
