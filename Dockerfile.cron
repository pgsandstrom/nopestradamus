FROM node:24-slim AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# ---- dependencies -----------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --no-optional

# ---- runtime ----------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production

RUN echo "postfix postfix/mailname string nopestradamus.com" | debconf-set-selections \
 && echo "postfix postfix/main_mailer_type string 'Internet Site'" | debconf-set-selections \
 && apt-get update \
 && apt-get install --assume-yes --no-install-recommends postfix \
 && rm -rf /var/lib/apt/lists/* \
 && postconf -e 'myhostname = nopestradamus.com'

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY server-cron.ts ./
COPY scripts ./scripts
COPY server ./server
COPY shared ./shared
COPY util ./util

# Baked into the image on purpose: the images are built on the deploy host and never
# pushed to a registry, so this is one less moving part. Both files are gitignored.
COPY privkey.pem config.json ./

# node runs the TypeScript directly via type stripping, so there is no build step
CMD service postfix start && node server-cron.ts
