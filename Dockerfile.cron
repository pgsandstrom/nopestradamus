FROM node:24-slim AS base
ENV NPM_CONFIG_LOGLEVEL=info
WORKDIR /app

# ---- dependencies -----------------------------------------------------------
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --omit=optional

# ---- runtime ----------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production

RUN echo "postfix postfix/mailname string nopestradamus.com" | debconf-set-selections \
 && echo "postfix postfix/main_mailer_type string 'Internet Site'" | debconf-set-selections \
 && apt-get update \
 && apt-get install --assume-yes --no-install-recommends postfix \
 && rm -rf /var/lib/apt/lists/* \
 && postconf -e 'myhostname = nopestradamus.com'

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY server-cron.ts ./
COPY server ./server
COPY shared ./shared
COPY util ./util

# TODO Is this how we want to handle privkey?
COPY privkey.pem config.json ./

# node runs the TypeScript directly via type stripping, so there is no build step
CMD service postfix start && node server-cron.ts
